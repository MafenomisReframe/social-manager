{
  "name": "social-manager",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-manager-db",
      "database_id": "4af520f0-a65c-4c63-ac9b-6d8144a25d71"
    }
  ]
}