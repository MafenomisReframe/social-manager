{
  "name": "social-manager",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-manager-db",
      "database_id": "4af520f0-a65c-4c63-ac9b-6d8144a25d71"
    }
  ],
  "vars": {
    "POLICY_AUD": "32bb6502c0890075baa29f08ccad548fe9f3b7b5eb32718c9dd0f59e4ca4c7b7",
    "APP_ORIGIN": "https://social-manager.simone-87d.workers.dev",
    "META_APP_ID": "1638911674695065",
    // ID app Instagram (Dashboard Meta > Instagram > Configurazione API con login Instagram).
    // I segreti IG_APP_SECRET e TOKEN_ENC_KEY si impostano come Secret in Cloudflare, MAI qui.
    "IG_APP_ID": "1386540906802908",
    // Facultativo: ID della "configurazione" di Facebook Login for Business (se assente si usano gli scope).
    // Secret richiesti per l'accesso tramite Facebook: META_APP_SECRET (+ TOKEN_ENC_KEY).
    "META_LOGIN_CONFIG_ID": ""
  },
  "triggers": {
    // Lettura giornaliera delle statistiche social (05:15 UTC).
    "crons": ["15 5 * * *"]
  }
}
